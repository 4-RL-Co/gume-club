{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // O `seed/cobertura.ts` roda pelo Node (`node --experimental-strip-types`), e o
    // Node exige a extensão no import. Sem isto, o script teria que virar .mjs e sair
    // do alcance do typecheck — e um script que mede o catálogo sem tipo é um script
    // que mente sobre o catálogo. Só vale porque `noEmit` é true: nada disto é compilado.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
