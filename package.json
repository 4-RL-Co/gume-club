{
  "name": "gume",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "audit:security": "node scripts/audit-security.mjs",
    "db:seed": "node scripts/seed-shelf.mjs seed/olegas-shelf.csv olegas",
    "db:seed:exemplo": "node scripts/seed-shelf.mjs seed/exemplo.csv exemplo",
    "db:import": "node --experimental-strip-types scripts/import-openlibrary.mjs",
    "autores": "node --experimental-strip-types scripts/backfill-authors.mjs",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "covers": "node scripts/backfill-covers.mjs",
    "covers:canone": "node scripts/backfill-covers.mjs --canone",
    "cobertura": "node --experimental-strip-types seed/cobertura.ts",
    "poda": "node scripts/poda.mjs",
    "podar": "pnpm db:migrate && node scripts/poda.mjs --executar && node scripts/poda.mjs --vacuum",
    "brand": "node scripts/brand.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.24.0",
    "next": "^15.1.0",
    "pg": "^8.22.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
