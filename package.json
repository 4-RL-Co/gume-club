{
  "name": "gume",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "drizzle-kit migrate && next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "audit:security": "node scripts/audit-security.mjs",
    "db:seed": "node scripts/seed-shelf.mjs seed/exemplo.csv exemplo",
    "db:seed:olegas": "node scripts/seed-shelf.mjs seed/olegas-shelf.csv olegas",
    "db:import": "node --experimental-strip-types scripts/import-openlibrary.mjs",
    "autores": "node --experimental-strip-types scripts/backfill-authors.mjs",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "db:seed:perfil-modelo": "node --experimental-strip-types scripts/seed-perfil-modelo.mjs",
    "personagens": "node --experimental-strip-types scripts/personagens-da-colecao.mjs",
    "covers": "node scripts/backfill-covers.mjs",
    "covers:canone": "node scripts/backfill-covers.mjs --canone",
    "cobertura": "node --experimental-strip-types seed/cobertura.ts",
    "poda": "node scripts/poda.mjs",
    "podar": "pnpm db:migrate && node scripts/poda.mjs --executar && node scripts/poda.mjs --vacuum",
    "brand": "node scripts/brand.mjs",
    "mapa-mundi": "node --experimental-strip-types scripts/gerar-mapa-mundi.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@vercel/blob": "^2.7.0",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.31.0",
    "next": "^15.5.23",
    "pg": "^8.23.0",
    "postgres": "^3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "simple-icons": "16.28.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "d3-geo": "^3.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.23",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "world-atlas": "^2.0.2"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=6.4.3",
      "esbuild": ">=0.25.0",
      "postcss": ">=8.5.10",
      "sharp": ">=0.35.0"
    }
  }
}
